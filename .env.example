# FinAlly — environment variables (PLAN.md §5).
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env

# Required for the AI chat assistant. Without it, the rest of the app
# (prices, portfolio, trading, watchlist) still works; POST /api/chat
# returns a clear error instead of a response.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses.
# Used by automated tests; leave "false" for normal use.
LLM_MOCK=false

# Path to the SQLite database file.
# Local (non-Docker) development default — repo-relative, matches
# backend/app/db/connection.py's own fallback when this is unset.
# The Docker image overrides this to /app/db/finally.db internally; you do
# not need to change it when running via scripts/start.sh, start.ps1, or
# docker-compose.yml.
DATABASE_PATH=db/finally.db
